# Copy this file to .env and fill in your own values. Never commit .env.

# --- Anthropic (trend research, persona + songwriting agents) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# --- Suno music generation ---
# vibemusicians talks to Suno through a third-party wrapper (there is no
# official public Suno API yet). Default here is kie.ai — get a key at
# https://kie.ai (dashboard -> API Keys). Other providers with a compatible
# generate + record-info API (sunoapi.org, apibox.erweima.ai) also work by
# changing SUNO_API_BASE_URL.
SUNO_API_BASE_URL=https://api.kie.ai
SUNO_API_KEY=
SUNO_MODEL=V4_5
# kie.ai requires this field but this app polls for results instead of using
# it, so it never needs to be a real reachable server — leave the default.
SUNO_CALLBACK_URL=https://example.com/vibemusicians-callback

# --- SoundCloud (distribution) ---
# Register an app at https://developers.soundcloud.com to get these.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://localhost:8912/callback
# Populated automatically by `vibemusicians soundcloud login`
SOUNDCLOUD_REFRESH_TOKEN=

# --- Rate limiting ---
# Max tracks published to SoundCloud per rolling 7-day window, per artist.
# `vibemusicians run` skips the publish step (and the paid API calls before
# it) once this is hit, without erroring.
WEEKLY_UPLOAD_LIMIT=3

# --- Local storage ---
DATA_DIR=data
