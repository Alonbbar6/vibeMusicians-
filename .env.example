# Copy this file to .env and fill in your own values. Never commit .env.

# --- Anthropic (trend research, persona + songwriting agents) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# --- Suno music generation ---
# vibemusicians talks to Suno through a generic REST wrapper (there is no
# official public Suno API yet). Point these at whichever third-party
# provider you have access to (e.g. sunoapi.org, kie.ai, apibox.erweima.ai,
# useapi.net) as long as it exposes a generate + record-info style API.
SUNO_API_BASE_URL=https://api.sunoapi.org
SUNO_API_KEY=
SUNO_MODEL=V4_5

# --- SoundCloud (distribution) ---
# Register an app at https://developers.soundcloud.com to get these.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://localhost:8912/callback
# Populated automatically by `vibemusicians soundcloud login`
SOUNDCLOUD_REFRESH_TOKEN=

# --- Local storage ---
DATA_DIR=data
